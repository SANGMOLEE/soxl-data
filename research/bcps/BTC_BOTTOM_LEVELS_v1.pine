//@version=6
// ═══════════════════════════════════════════════════════════════════
//  BTC 저점 가격선 v1 (2026-11-20) — 가격 차트 위에 사전 등록 가격선을 긋는다
//  종합 연구 research/BTC_BOTTOM_MASTER_2026-11-20.md §5·§9 의 숫자.
//  실현가격·사전 등록선은 입력값이라 온체인 갱신 때 바꾸면 된다(기본값 = 11/20 기준).
//  200일선·200주선·실현가 배수선은 차트에서 계산.
//  경보: 각 사전 등록선 종가 이탈/돌파.
// ═══════════════════════════════════════════════════════════════════
indicator("BTC 저점 가격선 v1", shorttitle="BTC저점선", overlay=true, max_lines_count=50, max_labels_count=50)

grpA = "아래(저점 구간)"
pAlarm = input.float(60500,  "저점 구간 알람(2단계)",      group=grpA)
pMv11  = input.float(58744,  "MVRV 1.1",                    group=grpA)
pJun   = input.float(58559,  "6/30 저점 종가",              group=grpA)
pBear  = input.float(56292,  "-35% 재성립(엔진 재진입)",    group=grpA)
pReal  = input.float(53404,  "실현가격 (MVRV 1.0)",         group=grpA)
pB     = input.float(48000,  "MVRV 0.9 / BCPS<15",          group=grpA)
pInval = input.float(45000,  "무효선(모형 밖)",             group=grpA)
grpB = "위(상승 확인)"
pMa200 = input.float(72600,  "200일선(11/20)",              group=grpB)
pEtf   = input.float(81300,  "ETF 평균가(1차 확인)",        group=grpB)
pLth   = input.float(86603,  "장기보유 매물(2차 확인)",     group=grpB)
grpC = "표시"
showMa  = input.bool(true, "200일선·200주선(차트 계산)", group=grpC)
showRp  = input.bool(true, "실현가 배수선 0.9/1.0/1.1/1.2", group=grpC)
showLv  = input.bool(true, "사전 등록 가격선", group=grpC)

ma200  = ta.sma(close, 200)
ma1400 = ta.sma(close, 1400)
plot(showMa ? ma200 : na,  "200일선", color = color.new(#f59e0b, 0), linewidth = 2)
plot(showMa ? ma1400 : na, "200주선", color = color.new(#8b5cf6, 0), linewidth = 2)

f_line(float p, color c, string txt, string sty) =>
    var line  ln = na
    var label lb = na
    if barstate.islast and not na(p)
        line.delete(ln)
        label.delete(lb)
        ln := line.new(bar_index - 300, p, bar_index + 20, p, color = c, width = 1, style = sty, extend = extend.right)
        lb := label.new(bar_index + 20, p, txt + "  " + str.tostring(p, "#,###"), style = label.style_label_left, color = color.new(c, 20), textcolor = color.white, size = size.small)

f_line(showLv ? pAlarm : na, #dc2626, "알람 2단계·1차매수", line.style_dashed)
f_line(showLv ? pMv11  : na, #f97316, "MVRV 1.1", line.style_dotted)
f_line(showLv ? pJun   : na, #b91c1c, "6/30 저점", line.style_solid)
f_line(showLv ? pBear  : na, #ea580c, "-35% 재성립", line.style_dotted)
f_line(showLv ? pReal  : na, #7c2d12, "실현가격", line.style_solid)
f_line(showLv ? pB     : na, #991b1b, "MVRV0.9·BCPS<15", line.style_dashed)
f_line(showLv ? pInval : na, #111827, "무효선 45,000", line.style_solid)
f_line(showLv ? pEtf   : na, #2563eb, "ETF 평균가 1차확인", line.style_dashed)
f_line(showLv ? pLth   : na, #1e3a8a, "장기보유 매물 2차확인", line.style_dashed)
f_line(showRp ? pReal * 0.9 : na, #7f1d1d, "실현가×0.9", line.style_dotted)
f_line(showRp ? pReal * 1.2 : na, #fb923c, "실현가×1.2", line.style_dotted)

// ── 경보(종가 기준) ─────────────────────────────────────────────────
alertcondition(ta.crossunder(close, pAlarm), "60,500 이탈(알람가)",   "BTC 종가 알람가 이탈 — 탐지기 2단계 확인")
alertcondition(ta.crossunder(close, pMv11),  "MVRV 1.1 이탈",         "BTC 종가 MVRV 1.1 아래 — 가치 층 1차")
alertcondition(ta.crossunder(close, pJun),   "6/30 저점 이탈",        "BTC 6/30 저점 종가 이탈 — 시나리오 C 폐기")
alertcondition(ta.crossunder(close, pBear),  "-35% 재성립",           "BTC -35% 재성립 — 엔진 재진입 조건 1")
alertcondition(ta.crossunder(close, pReal),  "실현가격 이탈",         "BTC 실현가격 아래 — 시나리오 B 본구간")
alertcondition(ta.crossunder(close, pB),     "48,000 이탈",           "BTC 48,000 이탈 — MVRV 0.9·BCPS<15 구간")
alertcondition(ta.crossunder(close, pInval), "45,000 이탈(모형 밖)",  "BTC 45,000 이탈 — 전면 재검")
alertcondition(ta.crossover(close, ma200),   "200일선 회복",          "BTC 200일선 위 마감")
alertcondition(ta.crossover(close, pEtf),    "81,300 돌파(1차 확인)", "BTC 상승 사이클 1차 확인")
alertcondition(ta.crossover(close, pLth),    "86,603 돌파(2차 확인)", "BTC 상승 사이클 2차 확인")
