//@version=6
// ═══════════════════════════════════════════════════════════════
//  BCPS v1.1 — 비트코인 사이클 위치 스코어 (0~100)
//  낮을수록 저점형 · 높을수록 고점형
//
//  BCPS = mean(V, P, M, H)
//    V 가치평가      median(MVRV%, 200주Mayer%, DEV730%)
//    P 가격위치      mean(365일수익%, ATH낙폭%)
//    M 실현가 모멘텀  실현가격 30일/365일 비율의 백분위
//    H 채굴경제      해시프라이스(추세제거)의 백분위
//  각 원지표는 4년·5년 창 백분위 평균으로 0~100 표준화
//
//  ── 왜 점수를 내장했는가 ──────────────────────────────────
//  Pine에서 직접 계산하면 200주 이동평균(1,400봉) 위에 다시
//  1,825봉 백분위가 필요해 과거 3,225봉의 여유를 요구한다.
//  트레이딩뷰가 주는 봉 수를 넘겨 앞부분이 잘렸다.
//  그래서 파이썬으로 전 기간을 계산해 문자열로 내장했다.
//  덕분에 2016-05-15부터 전 구간이 끊김 없이 나온다.
//
//  ── 사건별 점수 ──────────────────────────────────────────
//  고점 2017-12-16 96.9 | 2021-04-13 91.9 | 2021-11-08 81.6
//       2024-03-13 78.8 | 2025-10-06 70.3
//  저점 2018-12-14 11.1 | 2020-03-12 33.5 | 2022-11-21  5.4
//  중간 2021-07-20 64.1 | 2024-09-06 53.0   ← 중간조정은 못 잡음
//  역대 최저 2022-12-19 = 4.85
//
//  ── 반드시 함께 볼 것 ────────────────────────────────────
//  백분위는 저점에서 포화되어 사이클 간 깊이를 구분하지 못한다.
//  MVRV 원값을 함께 보라 (하단 별도 창 또는 데이터 창).
//    2018 저점 0.693 | 2022 저점 0.778 | 현재 1.225
//
//  내장 자료 2016-05-15 ~ 2026-08-05. 이후는 표시하지 않는다.
// ═══════════════════════════════════════════════════════════════
indicator("BCPS v1.1 비트코인 사이클 위치", shorttitle="BCPS", overlay=false, precision=2)

// ── 입력 ────────────────────────────────────────────────────────
palette = input.string("저점=빨강", "구간 색 배치", options=["저점=빨강","저점=파랑"], group="표시",
     tooltip="저점=빨강: 낮은 점수를 진한 빨강으로.  저점=파랑: 통상적 배색(낮은 점수 파랑, 높은 점수 빨강)")
showBg  = input.bool(true,  "구간 배경 음영",   group="표시")
bgTrans = input.int(80, "배경 투명도", minval=50, maxval=97, group="표시")
showLbl = input.bool(true,  "현재 점수 말풍선", group="표시")
showMk  = input.bool(true,  "구간 전환 표시",   group="표시")
showMv  = input.bool(false, "MVRV 원값 선 겹쳐보기 (x20 배율)", group="표시",
     tooltip="MVRV를 20배 하여 같은 축에 표시한다. MVRV 1.0 = 20, 2.0 = 40, 4.0 = 80")

// ── 내장 자료 ───────────────────────────────────────────────────
// BCPS : 4자리 = 값 x100  (9999 = 결측)   시작 2016-05-15 UTC
// MVRV : 3자리 = 값 x100  ( 999 = 결측)   동일 시작일
BCPS_STR = ""
MVRV_STR = ""

curTs  = timestamp("UTC", year, month, dayofmonth, 0, 0)
baseTs = timestamp("UTC", 2016, 5, 15, 0, 0)
idx    = math.floor((curTs - baseTs) / 86400000)

nDays  = math.floor(str.length(BCPS_STR) / 4)
inRange = idx >= 0 and idx < nDays

bcpsRaw = float(na)
if inRange
    r = str.tonumber(str.substring(BCPS_STR, idx * 4, idx * 4 + 4))
    bcpsRaw := r >= 9999 ? na : r / 100.0

mvrvRaw = float(na)
if inRange
    m = str.tonumber(str.substring(MVRV_STR, idx * 3, idx * 3 + 3))
    mvrvRaw := m >= 999 ? na : m / 100.0

BCPS = bcpsRaw
MVRV = mvrvRaw
expired = idx >= nDays

// ── 8구간 정의 ──────────────────────────────────────────────────
//  경계 : 5 · 15 · 28 · 42 · 60 · 74 · 86
//  실제 빈도 : 0.11% / 8.67% / 6.75% / 15.77% / 23.51% / 25.94% / 12.45% / 6.80%
band(x) =>
    na(x) ? -1 : x < 5 ? 0 : x < 15 ? 1 : x < 28 ? 2 : x < 42 ? 3 : x < 60 ? 4 : x < 74 ? 5 : x < 86 ? 6 : 7

bandName(b) =>
    b == 0 ? "최극단 저점" : b == 1 ? "극저점권" : b == 2 ? "저점권" : b == 3 ? "저평가" : b == 4 ? "중립" : b == 5 ? "과열" : b == 6 ? "고점권" : b == 7 ? "극고점권" : "자료없음"

// 저점=빨강 배색 : 진빨강 → 빨강 → 주황 → 노랑 → 회색 → 하늘 → 파랑 → 진파랑
c0 = #7f1d1d
c1 = #dc2626
c2 = #f97316
c3 = #eab308
c4 = #94a3b8
c5 = #38bdf8
c6 = #2563eb
c7 = #1e3a8a

bandColor(b) =>
    lowRed = palette == "저점=빨강"
    b == 0 ? (lowRed ? c0 : c7) :
     b == 1 ? (lowRed ? c1 : c6) :
     b == 2 ? (lowRed ? c2 : c5) :
     b == 3 ? (lowRed ? c3 : c4) :
     b == 4 ? (lowRed ? c4 : c3) :
     b == 5 ? (lowRed ? c5 : c2) :
     b == 6 ? (lowRed ? c6 : c1) :
     b == 7 ? (lowRed ? c7 : c0) : color.gray

bIdx = band(BCPS)
bCol = bandColor(bIdx)

// ── 작도 ────────────────────────────────────────────────────────
plot(BCPS, "BCPS", color = bCol, linewidth = 3, style = plot.style_line)
plot(showMv and not na(MVRV) ? MVRV * 20 : na, "MVRV x20", color = color.new(#a855f7, 25), linewidth = 1, style = plot.style_line)

bgcolor(showBg and not na(BCPS) ? color.new(bCol, bgTrans) : na, title = "구간 배경")

hline(5,  "5 최극단",  color = color.new(#7f1d1d, 25), linestyle = hline.style_solid)
hline(15, "15 극저점", color = color.new(#dc2626, 35), linestyle = hline.style_dashed)
hline(28, "28 저점권", color = color.new(#f97316, 45), linestyle = hline.style_dotted)
hline(42, "42 저평가", color = color.new(#eab308, 55), linestyle = hline.style_dotted)
hline(60, "60 중립",   color = color.new(color.gray, 55), linestyle = hline.style_dotted)
hline(74, "74 고점권", color = color.new(#2563eb, 45), linestyle = hline.style_dotted)
hline(86, "86 극고점", color = color.new(#1e3a8a, 25), linestyle = hline.style_solid)

// 구간이 바뀌는 시점만 표시
chg = showMk and not na(BCPS) and not na(BCPS[1]) and bIdx != band(BCPS[1])
plotshape(chg and bIdx < band(BCPS[1]) ? BCPS : na, "구간 하락", shape.triangledown, location.absolute, #dc2626, size = size.tiny)
plotshape(chg and bIdx > band(BCPS[1]) ? BCPS : na, "구간 상승", shape.triangleup,   location.absolute, #2563eb, size = size.tiny)

// ── 현재 점수 말풍선 ────────────────────────────────────────────
var label lb = na
if barstate.islast
    label.delete(lb)
    if showLbl
        txt = na(BCPS) ? (expired ? "내장자료 만료\n(2026-08-05까지)" : "자료없음") :
             str.tostring(BCPS, "#.0") + "  " + bandName(bIdx) + (na(MVRV) ? "" : "\nMVRV " + str.tostring(MVRV, "#.00"))
        lb := label.new(bar_index, na(BCPS) ? 50 : BCPS, txt, style = label.style_label_left,
             size = size.normal, textcolor = color.white, color = na(BCPS) ? color.new(color.gray, 20) : color.new(bCol, 10))

// ── 데이터 창 ───────────────────────────────────────────────────
plot(BCPS,  "BCPS 점수",   display = display.data_window)
plot(bIdx,  "구간 번호",   display = display.data_window)
plot(MVRV,  "MVRV 원값",   display = display.data_window)

// ── 경보 ────────────────────────────────────────────────────────
alertcondition(ta.crossunder(BCPS, 28), "저점권 진입 28",   "BCPS 28 하향")
alertcondition(ta.crossunder(BCPS, 15), "극저점권 진입 15", "BCPS 15 하향")
alertcondition(ta.crossunder(BCPS, 5),  "최극단 진입 5",    "BCPS 5 하향")
alertcondition(ta.crossover(BCPS, 74),  "고점권 진입 74",   "BCPS 74 상향")
alertcondition(ta.crossover(BCPS, 86),  "극고점권 진입 86", "BCPS 86 상향")
