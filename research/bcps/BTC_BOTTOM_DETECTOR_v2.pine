//@version=6
// ═══════════════════════════════════════════════════════════════════
//  BTC 저점 탐지기 v2  (2026-11-20)  — 빠른 층 + 가치 층을 한 창에
//
//  빠른 층(차트에서 직접 계산 — 일봉 BTCUSD 차트에 올릴 것):
//    A 일간 RSI(14) ≤ 30      B 주간 RSI(14) ≤ 35
//    C 200일선 대비 ≤ -20%    D 200주선(1400일) 대비 ≤ +5%
//    E 30일 고점 대비 ≤ -25%  F 7일 수익 ≤ -15%
//    G 최근 5일 안 투매일(거래량 ≥ 30일 중앙값×2 그리고 하루 ≤ -5% 또는 3일 ≤ -10%)
//    H 사상 최고가 대비 ≤ -50%
//    점수 = 켜진 조건 수(0~8).  1단계 ≥3, 2단계 ≥5, 3단계 ≥6이고 G.
//    게이트 = 고점 후 240일 이상 & 고점 대비 -45% 이하.   저점 구간(1차 매수) = 게이트 & 2단계.
//    반전(3차 매수): 점수 정점 통과(10일 최고 ≥6 뒤 2점 하락 & 3일 전보다 상승) / 5일 종가고점 돌파(15일 안 2단계).
//  가치 층(BCPS v1.2 내장, 2016-05-15~2026-11-20): 0~100, 낮을수록 저점형. 경계 5·15·28·42·60·74·86.
//  저장소 research/bottom_detector.py 와 같은 규칙. 파이썬은 달력일 기준·주간RSI는 7일 간격 굴림이라
//  거래소 봉·주봉 RSI와 1점 안팎 차이가 날 수 있다. 차트는 Bitstamp/Coinbase 처럼 2014년 이전 이력이 있는 것이 좋다
//  (200주선·사상최고가 계산에 긴 이력이 필요. 이력이 짧으면 D가 "자료부족", H가 2017 고점 기준이 됨).
//
//  경보 7종(알림 만들기 → 조건에서 이 지표 선택):
//    2단계 진입 / 저점 구간(1차) / 3단계 투매(2차) / 반전 정점통과(3차) / 반전 5일돌파(3차) / BCPS<15 / BCPS<28
// ═══════════════════════════════════════════════════════════════════
indicator("BTC 저점 탐지기 v2 (점수+BCPS)", shorttitle="BTC저점v2", overlay=false, precision=1, max_labels_count=50)

// ── 입력 ────────────────────────────────────────────────────────────
showTbl  = input.bool(true,  "조건표 표시",       group="표시")
showLbl  = input.bool(true,  "현재 말풍선",       group="표시")
showBg   = input.bool(true,  "단계 배경 음영",    group="표시")
showBcps = input.bool(true,  "BCPS 선 표시",      group="표시")
showRev  = input.bool(true,  "반전 신호 표시",    group="표시")
gateDays = input.int(240,    "게이트: 고점 후 일수", minval=60, group="규칙")
gateDD   = input.float(-45.0, "게이트: 고점 대비 %", maxval=0, group="규칙")

// ── 빠른 층 ─────────────────────────────────────────────────────────
rsiD   = ta.rsi(close, 14)
rsiW   = request.security(syminfo.tickerid, "W", ta.rsi(close, 14), lookahead=barmerge.lookahead_off)
ma200  = ta.sma(close, 200)
ma1400 = ta.sma(close, 1400)
mayer  = close / ma200 - 1
w200   = close / ma1400 - 1
dd30   = close / ta.highest(close, 30) - 1
r7     = close / close[7] - 1
r1     = close / close[1] - 1
r3     = close / close[3] - 1
vmed   = ta.median(volume, 30)[1]
capday = volume >= 2 * vmed and (r1 <= -0.05 or r3 <= -0.10)
sinceCap = ta.barssince(capday)
condG  = not na(sinceCap) and sinceCap <= 4

var float ath = na
var int athTime = na
ath := na(ath) ? close : math.max(ath, close)
if close >= ath
    athTime := time
ddath   = close / ath - 1
daysAth = na(athTime) ? 0.0 : (time - athTime) / 86400000.0

condA = rsiD <= 30
condB = rsiW <= 35
condC = mayer <= -0.20
condD = not na(ma1400) and w200 <= 0.05
condE = dd30 <= -0.25
condF = r7 <= -0.15
condH = ddath <= -0.50
score = (condA ? 1 : 0) + (condB ? 1 : 0) + (condC ? 1 : 0) + (condD ? 1 : 0) + (condE ? 1 : 0) + (condF ? 1 : 0) + (condG ? 1 : 0) + (condH ? 1 : 0)
level = score >= 6 and condG ? 3 : score >= 5 ? 2 : score >= 3 ? 1 : 0
gate  = daysAth >= gateDays and ddath <= gateDD / 100.0
zone  = gate and level >= 2

// 반전 신호
scoreMax10 = ta.highest(score, 10)
revPeak    = scoreMax10 >= 6 and score <= scoreMax10 - 2 and close > close[3]
lv2        = level >= 2 ? 1.0 : 0.0
zone15     = ta.highest(lv2, 15) >= 1
revBreak   = zone15 and close > ta.highest(close[1], 5) and close[1] <= ta.highest(close[2], 5)

// ── 가치 층 (BCPS v1.2 내장) ─────────────────────────────────────────
// BCPS: 4자리 = 값×100 (9999 = 결측), MVRV: 3자리 = 값×100 (999 = 결측). 시작 2016-05-15 UTC
BCPS_STR = ""
MVRV_STR = ""
curTs   = timestamp("UTC", year, month, dayofmonth, 0, 0)
baseTs  = timestamp("UTC", 2016, 5, 15, 0, 0)
idx     = math.floor((curTs - baseTs) / 86400000)
nDays   = math.floor(str.length(BCPS_STR) / 4)
inRange = idx >= 0 and idx < nDays
float bcps = na
float mvrv = na
if inRange
    rb = str.tonumber(str.substring(BCPS_STR, idx * 4, idx * 4 + 4))
    bcps := rb >= 9999 ? na : rb / 100.0
    rm = str.tonumber(str.substring(MVRV_STR, idx * 3, idx * 3 + 3))
    mvrv := rm >= 999 ? na : rm / 100.0
bandName(float x) =>
    na(x) ? "자료없음" : x < 5 ? "최극단 저점" : x < 15 ? "극저점권" : x < 28 ? "저점권" : x < 42 ? "저평가" : x < 60 ? "중립" : x < 74 ? "과열" : x < 86 ? "고점권" : "극고점권"
pct(float v) =>
    str.tostring(v * 100, "#.0") + "%"

// ── 색 ──────────────────────────────────────────────────────────────
lvCol = level == 3 ? #7f1d1d : level == 2 ? #dc2626 : level == 1 ? #f97316 : #94a3b8
zCol  = zone ? #b91c1c : lvCol

// ── 작도 (한 축 0~100: 점수×10 막대 + BCPS 선) ───────────────────────
plot(score * 10, "점수×10", color = zCol, style = plot.style_columns, linewidth = 2)
plot(showBcps ? bcps : na, "BCPS", color = color.new(#2563eb, 0), linewidth = 2)
hline(30, "1단계(3점)",      color = color.new(#f97316, 60), linestyle = hline.style_dotted)
hline(50, "2단계(5점)",      color = color.new(#dc2626, 40), linestyle = hline.style_dashed)
hline(60, "3단계(6점)",      color = color.new(#7f1d1d, 30), linestyle = hline.style_solid)
hline(15, "BCPS 15 극저점",  color = color.new(#2563eb, 50), linestyle = hline.style_dashed)
hline(28, "BCPS 28 저점권",  color = color.new(#2563eb, 70), linestyle = hline.style_dotted)
bgcolor(showBg and zone ? color.new(#dc2626, 80) : showBg and level == 3 ? color.new(#7f1d1d, 85) : showBg and level == 2 ? color.new(#dc2626, 88) : na, title = "단계 배경")
plotshape(showRev and revPeak ? 95 : na,   "반전: 점수 정점 통과",     shape.triangleup, location.absolute, #16a34a, size = size.small, text = "정점통과")
plotshape(showRev and revBreak ? 90 : na,  "반전: 5일 종가고점 돌파",  shape.triangleup, location.absolute, #15803d, size = size.small, text = "5일돌파")
plotshape(zone and not zone[1] ? 55 : na,  "저점 구간 진입",           shape.diamond,    location.absolute, #b91c1c, size = size.small, text = "저점구간")

// ── 조건표 ──────────────────────────────────────────────────────────
var table tb = table.new(position.top_right, 3, 11, border_width = 1)
if showTbl and barstate.islast
    onC  = color.new(#dc2626, 20)
    offC = color.new(#374151, 40)
    hdr  = #111827
    table.cell(tb, 0, 0, "조건", text_color = color.white, bgcolor = hdr)
    table.cell(tb, 1, 0, "현재", text_color = color.white, bgcolor = hdr)
    table.cell(tb, 2, 0, "기준", text_color = color.white, bgcolor = hdr)
    cA = condA ? onC : offC
    table.cell(tb, 0, 1, "A 일간RSI", text_color = color.white, bgcolor = cA)
    table.cell(tb, 1, 1, str.tostring(rsiD, "#"), text_color = color.white, bgcolor = cA)
    table.cell(tb, 2, 1, "≤30", text_color = color.white, bgcolor = cA)
    cB = condB ? onC : offC
    table.cell(tb, 0, 2, "B 주간RSI", text_color = color.white, bgcolor = cB)
    table.cell(tb, 1, 2, str.tostring(rsiW, "#"), text_color = color.white, bgcolor = cB)
    table.cell(tb, 2, 2, "≤35", text_color = color.white, bgcolor = cB)
    cC = condC ? onC : offC
    table.cell(tb, 0, 3, "C 200일선", text_color = color.white, bgcolor = cC)
    table.cell(tb, 1, 3, pct(mayer), text_color = color.white, bgcolor = cC)
    table.cell(tb, 2, 3, "≤-20%", text_color = color.white, bgcolor = cC)
    cD = condD ? onC : offC
    table.cell(tb, 0, 4, "D 200주선", text_color = color.white, bgcolor = cD)
    table.cell(tb, 1, 4, na(ma1400) ? "자료부족" : pct(w200), text_color = color.white, bgcolor = cD)
    table.cell(tb, 2, 4, "≤+5%", text_color = color.white, bgcolor = cD)
    cE = condE ? onC : offC
    table.cell(tb, 0, 5, "E 30일고점", text_color = color.white, bgcolor = cE)
    table.cell(tb, 1, 5, pct(dd30), text_color = color.white, bgcolor = cE)
    table.cell(tb, 2, 5, "≤-25%", text_color = color.white, bgcolor = cE)
    cF = condF ? onC : offC
    table.cell(tb, 0, 6, "F 7일", text_color = color.white, bgcolor = cF)
    table.cell(tb, 1, 6, pct(r7), text_color = color.white, bgcolor = cF)
    table.cell(tb, 2, 6, "≤-15%", text_color = color.white, bgcolor = cF)
    cG = condG ? onC : offC
    table.cell(tb, 0, 7, "G 투매일", text_color = color.white, bgcolor = cG)
    table.cell(tb, 1, 7, condG ? "5일 안 있음" : "없음", text_color = color.white, bgcolor = cG)
    table.cell(tb, 2, 7, "거래량2배 급락", text_color = color.white, bgcolor = cG)
    cH = condH ? onC : offC
    table.cell(tb, 0, 8, "H ATH대비", text_color = color.white, bgcolor = cH)
    table.cell(tb, 1, 8, pct(ddath), text_color = color.white, bgcolor = cH)
    table.cell(tb, 2, 8, "≤-50%", text_color = color.white, bgcolor = cH)
    gc = gate ? color.new(#b91c1c, 20) : offC
    table.cell(tb, 0, 9, "게이트", text_color = color.white, bgcolor = gc)
    table.cell(tb, 1, 9, str.tostring(daysAth, "#") + "일 / " + pct(ddath), text_color = color.white, bgcolor = gc)
    table.cell(tb, 2, 9, "≥" + str.tostring(gateDays) + "일 & ≤" + str.tostring(gateDD, "#") + "%", text_color = color.white, bgcolor = gc)
    sc = zone ? color.new(#b91c1c, 0) : lvCol
    table.cell(tb, 0, 10, "점수/단계", text_color = color.white, bgcolor = sc)
    table.cell(tb, 1, 10, str.tostring(score) + "/8  " + str.tostring(level) + "단계" + (zone ? " 저점구간" : ""), text_color = color.white, bgcolor = sc)
    table.cell(tb, 2, 10, na(bcps) ? "BCPS 자료없음" : "BCPS " + str.tostring(bcps, "#.0") + " " + bandName(bcps) + (na(mvrv) ? "" : "  MVRV " + str.tostring(mvrv, "#.00")), text_color = color.white, bgcolor = sc)

// ── 현재 말풍선 ───────────────────────────────────────────────────────
var label lb = na
if barstate.islast and showLbl
    label.delete(lb)
    txt = "점수 " + str.tostring(score) + "/8 · " + str.tostring(level) + "단계" + (zone ? " · 저점구간" : "") + (gate ? "" : " · 게이트 밖") + (na(bcps) ? "" : "\nBCPS " + str.tostring(bcps, "#.0") + " " + bandName(bcps)) + (revPeak ? "\n반전: 정점통과" : "") + (revBreak ? "\n반전: 5일돌파" : "")
    lb := label.new(bar_index, score * 10, txt, style = label.style_label_left, size = size.normal, textcolor = color.white, color = color.new(zCol, 10))

// ── 데이터 창 ─────────────────────────────────────────────────────────
plot(score,          "점수",        display = display.data_window)
plot(level,          "단계",        display = display.data_window)
plot(gate ? 1 : 0,   "게이트",      display = display.data_window)
plot(mvrv,           "MVRV(내장)",  display = display.data_window)
plot(daysAth,        "고점 후 일수", display = display.data_window)

// ── 경보 ──────────────────────────────────────────────────────────────
alertcondition(level >= 2 and level[1] < 2,  "2단계 진입(5점)",              "BTC 저점탐지 2단계: 점수 5 이상")
alertcondition(zone and not zone[1],         "저점 구간(1차 매수)",          "BTC 저점 구간: 게이트+2단계 — 1차 매수 신호")
alertcondition(level == 3 and level[1] < 3,  "3단계 투매(2차 매수)",         "BTC 3단계: 투매일 + 6점 — 2차 매수 신호")
alertcondition(revPeak and not revPeak[1],   "반전: 점수 정점 통과(3차)",    "BTC 반전 확인: 점수 정점 통과 — 3차 매수 신호")
alertcondition(revBreak,                     "반전: 5일 종가고점 돌파(3차)", "BTC 반전 확인: 5일 종가고점 돌파 — 3차 매수 신호")
alertcondition(ta.crossunder(bcps, 15),      "BCPS 15 하향(극저점권)",       "BCPS 15 하향 — 가치 층 1차 매수 신호")
alertcondition(ta.crossunder(bcps, 28),      "BCPS 28 하향(저점권)",         "BCPS 28 하향 — 저점권 진입")
