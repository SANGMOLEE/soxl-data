//@version=6
// ═══════════════════════════════════════════════════════════════════
//  BTC 저점 점수 v3 (0~100) + 정밀 트리거  (2026-11-20)
//  연구: research/score100_research_2026-11-20.md · 운용 코드 research/score100.py 와 같은 규칙
//
//  구간 Z  = 4년(1460봉) 백분위 평균: 200일선 이격 · 200주선(1400일) 이격 · 사상최고가 낙폭 · MVRV(내장) · 주간 RSI14
//  타이밍 T = 4년 백분위 평균: 일간 RSI14 · 30일 낙폭 · 90일 낙폭 · 볼린저 z(20) · 50일선 이격 · 7일 수익
//  점수 = 0.5 Z + 0.5 T.   띠: ≥90 극저점 / 80~90 저점권 / 65~80 저평가 / <65 중립
//  게이트 = 고점 후 240일 이상 & 고점 대비 -45% 이하
//  후보일  = 점수 ≥ 85 & 종가 20일 신저가 & 게이트          (그날 저녁에 알 수 있음)
//  트리거  = 전날이 후보일 & 오늘 종가 > 전날 종가            (오늘 종가에 매수 — 과거 사이클 저점 당일 4/4 포착, 가짜 11/16건)
//  강한 트리거 = 후보일 점수 ≥ 90
//  정점 통과 = 점수가 10일 최고보다 15점 이상 내려오고 3일 전보다 종가 상승 (저점이 지났다는 사후 확인)
//
//  백분위는 봉 1460개가 쌓여야 나온다. 200주선 항목은 2,860봉(약 7.8년) 뒤부터. 이력이 짧으면 있는 항목만 평균한다.
//  일봉 BTCUSD, 2014년 이전 이력이 있는 차트(Bitstamp·Coinbase) 권장. 파이썬(달력일)과 1~2점 차이 가능.
//  경보 6종: 후보일 / 트리거 / 강한 트리거 / 점수 85 상향 / 점수 90 상향 / 정점 통과
// ═══════════════════════════════════════════════════════════════════
indicator("BTC 저점 점수 v3 (100점+트리거)", shorttitle="BTC저점100", overlay=false, precision=1, max_labels_count=100)

showTbl  = input.bool(true,  "구성표 표시",      group="표시")
showLbl  = input.bool(true,  "현재 말풍선",      group="표시")
showBg   = input.bool(true,  "띠 배경 음영",     group="표시")
showZT   = input.bool(true,  "구간 Z·타이밍 T 선", group="표시")
thr      = input.float(85,   "트리거 임계(점수)", minval=50, maxval=99, group="규칙")
thrS     = input.float(90,   "강한 트리거 임계",  minval=50, maxval=99, group="규칙")
win      = input.int(1460,   "백분위 창(봉)",    minval=200, group="규칙")
gateDays = input.int(240,    "게이트: 고점 후 일수", group="규칙")
gateDD   = input.float(-45.0, "게이트: 고점 대비 %", group="규칙")

// ── 원지표 ──────────────────────────────────────────────────────────
rsi14  = ta.rsi(close, 14)
rsiW   = request.security(syminfo.tickerid, "W", ta.rsi(close, 14), lookahead=barmerge.lookahead_off)
ma200  = ta.sma(close, 200)
ma1400 = ta.sma(close, 1400)
ma50   = ta.sma(close, 50)
mayer  = close / ma200 - 1
w200   = close / ma1400 - 1
ma50d  = close / ma50 - 1
dd30   = close / ta.highest(close, 30) - 1
dd90   = close / ta.highest(close, 90) - 1
r7     = close / close[7] - 1
bbz    = (close - ta.sma(close, 20)) / ta.stdev(close, 20)
var float ath = na
var int athTime = na
ath := na(ath) ? close : math.max(ath, close)
if close >= ath
    athTime := time
ddath   = close / ath - 1
daysAth = na(athTime) ? 0.0 : (time - athTime) / 86400000.0

// ── MVRV 내장 (3자리 = 값×100, 999 = 결측, 2016-05-15 UTC 시작) ─────────
MVRV_STR = ""
curTs   = timestamp("UTC", year, month, dayofmonth, 0, 0)
baseTs  = timestamp("UTC", 2016, 5, 15, 0, 0)
idx     = math.floor((curTs - baseTs) / 86400000)
nDays   = math.floor(str.length(MVRV_STR) / 3)
float mvrv = na
if idx >= 0 and idx < nDays
    rm = str.tonumber(str.substring(MVRV_STR, idx * 3, idx * 3 + 3))
    mvrv := rm >= 999 ? na : rm / 100.0

// ── 백분위 (낮을수록 저점형 → 부호를 뒤집어 percentrank) ──────────────
pr(float s) =>
    ta.percentrank(-s, win)
pMayer = pr(mayer)
pW200  = pr(w200)
pDdath = pr(ddath)
pMvrv  = pr(mvrv)
pRsiW  = pr(rsiW)
pRsi   = pr(rsi14)
pDd30  = pr(dd30)
pDd90  = pr(dd90)
pBbz   = pr(bbz)
pMa50  = pr(ma50d)
pR7    = pr(r7)

avg5(float a, float b, float c, float d, float e) =>
    s = 0.0
    n = 0
    if not na(a)
        s += a
        n += 1
    if not na(b)
        s += b
        n += 1
    if not na(c)
        s += c
        n += 1
    if not na(d)
        s += d
        n += 1
    if not na(e)
        s += e
        n += 1
    n == 0 ? na : s / n
avg6(float a, float b, float c, float d, float e, float f) =>
    s = 0.0
    n = 0
    if not na(a)
        s += a
        n += 1
    if not na(b)
        s += b
        n += 1
    if not na(c)
        s += c
        n += 1
    if not na(d)
        s += d
        n += 1
    if not na(e)
        s += e
        n += 1
    if not na(f)
        s += f
        n += 1
    n == 0 ? na : s / n

Z = avg5(pMayer, pW200, pDdath, pMvrv, pRsiW)
T = avg6(pRsi, pDd30, pDd90, pBbz, pMa50, pR7)
score = na(Z) or na(T) ? na : 0.5 * Z + 0.5 * T

// ── 게이트 · 후보 · 트리거 ─────────────────────────────────────────────
gate     = daysAth >= gateDays and ddath <= gateDD / 100.0
newLow20 = close <= ta.lowest(close, 20)
cand     = not na(score) and score >= thr and newLow20 and gate
trigger  = cand[1] and close > close[1]
strongT  = trigger and score[1] >= thrS
peakPass = not na(score) and score <= ta.highest(score, 10) - 15 and close > close[3]

bandName(float x) =>
    na(x) ? "자료없음" : x >= 90 ? "극저점" : x >= 80 ? "저점권" : x >= 65 ? "저평가" : "중립"
bandCol = na(score) ? color.gray : score >= 90 ? #7f1d1d : score >= 80 ? #dc2626 : score >= 65 ? #f97316 : #94a3b8

// ── 작도 ────────────────────────────────────────────────────────────
plot(score, "점수", color = bandCol, linewidth = 3)
plot(showZT ? Z : na, "구간 Z", color = color.new(#2563eb, 30), linewidth = 1)
plot(showZT ? T : na, "타이밍 T", color = color.new(#16a34a, 30), linewidth = 1)
hline(90, "90 극저점", color = color.new(#7f1d1d, 30), linestyle = hline.style_solid)
hline(85, "85 트리거 임계", color = color.new(#dc2626, 20), linestyle = hline.style_dashed)
hline(80, "80 저점권", color = color.new(#dc2626, 55), linestyle = hline.style_dotted)
hline(65, "65 저평가", color = color.new(#f97316, 60), linestyle = hline.style_dotted)
bgcolor(showBg and not na(score) and score >= 90 ? color.new(#7f1d1d, 85) : showBg and not na(score) and score >= 80 ? color.new(#dc2626, 90) : na, title = "띠 배경")
plotshape(cand ? score : na, "후보일(20일 신저가·게이트)", shape.diamond, location.absolute, #f59e0b, size = size.tiny)
plotshape(trigger and not strongT ? score : na, "트리거(익일 확인)", shape.triangleup, location.absolute, #dc2626, size = size.small, text = "트리거")
plotshape(strongT ? score : na, "강한 트리거", shape.triangleup, location.absolute, #7f1d1d, size = size.normal, text = "강")
plotshape(peakPass and not peakPass[1] ? 100 : na, "정점 통과(저점 지남)", shape.triangledown, location.absolute, #16a34a, size = size.small, text = "정점통과")

// ── 구성표 ──────────────────────────────────────────────────────────
var table tb = table.new(position.top_right, 2, 14, border_width = 1)
cell(int r, string a, string b, color bg) =>
    table.cell(tb, 0, r, a, text_color = color.white, bgcolor = bg)
    table.cell(tb, 1, r, b, text_color = color.white, bgcolor = bg)
fmt(float v) => na(v) ? "—" : str.tostring(v, "#")
if showTbl and barstate.islast
    hdr = #111827
    c1 = color.new(#2563eb, 60)
    c2 = color.new(#16a34a, 60)
    cell(0, "항목", "백분위", hdr)
    cell(1, "구간 Z", fmt(Z), c1)
    cell(2, " 200일선 " + str.tostring(mayer * 100, "#.0") + "%", fmt(pMayer), c1)
    cell(3, " 200주선 " + (na(w200) ? "—" : str.tostring(w200 * 100, "#.0") + "%"), fmt(pW200), c1)
    cell(4, " ATH " + str.tostring(ddath * 100, "#.0") + "%", fmt(pDdath), c1)
    cell(5, " MVRV " + (na(mvrv) ? "—" : str.tostring(mvrv, "#.00")), fmt(pMvrv), c1)
    cell(6, " 주간RSI " + str.tostring(rsiW, "#"), fmt(pRsiW), c1)
    cell(7, "타이밍 T", fmt(T), c2)
    cell(8, " RSI14 " + str.tostring(rsi14, "#"), fmt(pRsi), c2)
    cell(9, " 30일 " + str.tostring(dd30 * 100, "#.0") + "% / 90일 " + str.tostring(dd90 * 100, "#.0") + "%", fmt(pDd30) + " / " + fmt(pDd90), c2)
    cell(10, " 볼린저z " + str.tostring(bbz, "#.0") + " / 50일선 " + str.tostring(ma50d * 100, "#.0") + "%", fmt(pBbz) + " / " + fmt(pMa50), c2)
    cell(11, " 7일 " + str.tostring(r7 * 100, "#.0") + "%", fmt(pR7), c2)
    gc = gate ? color.new(#b91c1c, 30) : color.new(#374151, 40)
    cell(12, "게이트 " + str.tostring(daysAth, "#") + "일 / " + str.tostring(ddath * 100, "#") + "%", gate ? "통과" : "밖", gc)
    sc = cand ? color.new(#f59e0b, 20) : trigger ? color.new(#dc2626, 10) : color.new(bandCol, 20)
    cell(13, "점수 " + str.tostring(score, "#.0") + " " + bandName(score), cand ? "후보일" : trigger ? "트리거" : newLow20 ? "20일 신저가" : "", sc)

// ── 말풍선 ──────────────────────────────────────────────────────────
var label lb = na
if barstate.islast and showLbl
    label.delete(lb)
    txt = "점수 " + str.tostring(score, "#.0") + " " + bandName(score) + "\nZ " + fmt(Z) + " · T " + fmt(T) + (gate ? "" : "\n게이트 밖") + (cand ? "\n후보일 → 내일 종가 상승이면 트리거" : "") + (trigger ? "\n트리거 확인(매수)" : "")
    lb := label.new(bar_index, score, txt, style = label.style_label_left, size = size.normal, textcolor = color.white, color = color.new(bandCol, 10))

// ── 데이터 창 ────────────────────────────────────────────────────────
plot(gate ? 1 : 0, "게이트", display = display.data_window)
plot(cand ? 1 : 0, "후보일", display = display.data_window)
plot(trigger ? 1 : 0, "트리거", display = display.data_window)
plot(mvrv, "MVRV(내장)", display = display.data_window)

// ── 경보 ────────────────────────────────────────────────────────────
alertcondition(cand and not cand[1],        "후보일(점수≥임계·20일 신저가)", "BTC 저점 후보일 — 내일 종가가 오늘보다 높으면 트리거")
alertcondition(trigger,                      "정밀 트리거(익일 확인)",        "BTC 정밀 트리거 확인 — 오늘 종가 매수 후보")
alertcondition(strongT,                      "강한 트리거(점수≥90)",          "BTC 강한 트리거 — 후보일 점수 90 이상")
alertcondition(ta.crossover(score, 85),      "점수 85 상향",                  "BTC 저점 점수 85 상향(트리거 임계)")
alertcondition(ta.crossover(score, 90),      "점수 90 상향(극저점)",          "BTC 저점 점수 90 상향")
alertcondition(peakPass and not peakPass[1], "정점 통과(저점 지남)",          "BTC 점수 정점 통과 — 저점이 지났다는 사후 확인")
